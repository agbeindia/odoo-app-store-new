<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="agbe_user_impersonation.ImpersonationBanner">
        <div t-if="info" class="o_impersonation_banner" role="status">
            <span class="o_impersonation_banner_icon fa fa-user-secret" aria-hidden="true"/>
            <span class="o_impersonation_banner_text">
                You are logged in as <b t-esc="info.target_name"/>
            </span>
            <a class="o_impersonation_banner_return btn btn-sm btn-light"
               t-att-href="info.return_url">
                Return to my account
            </a>
        </div>
    </t>

</templates>
