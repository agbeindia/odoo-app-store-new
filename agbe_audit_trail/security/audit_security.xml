<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_groups_privilege_audit_trail" model="res.groups.privilege">
        <field name="name">Audit Trail</field>
        <field name="sequence">50</field>
        <field name="category_id" ref="base.module_category_administration"/>
    </record>

    <!-- Auditor: read and export the logs. -->
    <record id="group_audit_user" model="res.groups">
        <field name="name">Auditor</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_audit_trail"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <!-- Manager: configure audit rules and purge logs. -->
    <record id="group_audit_manager" model="res.groups">
        <field name="name">Audit Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_audit_trail"/>
        <field name="implied_ids" eval="[Command.link(ref('agbe_audit_trail.group_audit_user'))]"/>
    </record>

    <!-- Every System Administrator is an Audit Manager (one-directional). -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('agbe_audit_trail.group_audit_manager'))]"/>
    </record>

    <record id="audit_log_company_rule" model="ir.rule">
        <field name="name">Audit Log: Multi-Company</field>
        <field name="model_id" ref="model_audit_log"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="audit_log_line_company_rule" model="ir.rule">
        <field name="name">Audit Log Line: Multi-Company</field>
        <field name="model_id" ref="model_audit_log_line"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
