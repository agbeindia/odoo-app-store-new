<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.form.inherit.negative.inventory.control</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <page name="inventory" position="inside">
                <group>
                    <group string="Negative Stock" name="negative_stock_policy_group" groups="stock.group_stock_manager">
                        <field name="negative_stock_policy" invisible="not is_storable"/>
                    </group>
                </group>
            </page>
        </field>
    </record>
</odoo>
