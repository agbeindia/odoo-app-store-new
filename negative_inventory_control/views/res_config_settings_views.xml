<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.negative.inventory.control</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='operations_setting_container']" position="inside">
                <setting id="negative_stock_policy_setting"
                         string="Negative Stock Policy"
                         help="Default policy applied when a stock operation would push on-hand quantity below zero. Can be refined per location, product category, or product.">
                    <field name="negative_stock_policy"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
