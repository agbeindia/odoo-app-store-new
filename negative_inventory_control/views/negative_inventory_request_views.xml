<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="negative_inventory_request_view_form" model="ir.ui.view">
        <field name="name">negative.inventory.request.form</field>
        <field name="model">negative.inventory.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" string="Submit for Approval" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object"
                            class="btn-primary" invisible="state != 'to_approve'"
                            groups="stock.group_stock_manager"/>
                    <button name="action_reject" string="Reject" type="object"
                            invisible="state != 'to_approve'"
                            groups="stock.group_stock_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,to_approve,approved,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_logs" type="object" class="oe_stat_button" icon="fa-list">
                            <field name="log_count" widget="statinfo" string="Audit Log"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="origin_display_name" string="Origin"/>
                            <button name="action_view_origin" type="object" string="Open" class="btn-link px-0"/>
                            <field name="picking_id" invisible="1"/>
                            <field name="scrap_id" invisible="1"/>
                            <field name="quant_id" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                        </group>
                        <group>
                            <field name="requested_by" readonly="1"/>
                            <field name="request_date" readonly="1"/>
                            <field name="approved_by" invisible="not approved_by"/>
                            <field name="decision_date" invisible="not decision_date"/>
                        </group>
                    </group>
                    <group string="Lines">
                        <field name="line_ids" nolabel="1">
                            <list create="false" delete="false">
                                <field name="product_id"/>
                                <field name="location_id"/>
                                <field name="quantity_before"/>
                                <field name="quantity_requested"/>
                                <field name="quantity_expected_after"/>
                            </list>
                        </field>
                    </group>
                    <group>
                        <field name="reason" placeholder="Why should this negative-stock transaction be allowed?" readonly="state != 'draft'"/>
                        <field name="decision_note" invisible="state not in ('approved', 'rejected', 'done')" readonly="not (state == 'to_approve')"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="negative_inventory_request_view_list" model="ir.ui.view">
        <field name="name">negative.inventory.request.list</field>
        <field name="model">negative.inventory.request</field>
        <field name="arch" type="xml">
            <list decoration-warning="state == 'to_approve'" decoration-muted="state in ('rejected',)">
                <field name="name"/>
                <field name="origin_display_name" string="Origin"/>
                <field name="requested_by"/>
                <field name="request_date"/>
                <field name="approved_by" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'to_approve'"
                       decoration-success="state in ('approved', 'done')"
                       decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="negative_inventory_request_view_kanban" model="ir.ui.view">
        <field name="name">negative.inventory.request.kanban</field>
        <field name="model">negative.inventory.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="d-flex justify-content-between">
                                <strong><field name="name"/></strong>
                                <field name="state" widget="label_selection"
                                       options="{'classes': {'draft': 'default', 'to_approve': 'info', 'approved': 'success', 'done': 'success', 'rejected': 'danger'}}"/>
                            </div>
                            <div><field name="origin_display_name"/></div>
                            <div class="text-muted">
                                <field name="requested_by"/> - <field name="request_date"/>
                            </div>
                            <div class="mt-2" invisible="state != 'to_approve'">
                                <button name="action_approve" type="object" string="Approve" class="btn btn-sm btn-primary" groups="stock.group_stock_manager"/>
                                <button name="action_reject" type="object" string="Reject" class="btn btn-sm btn-secondary" groups="stock.group_stock_manager"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="negative_inventory_request_view_search" model="ir.ui.view">
        <field name="name">negative.inventory.request.search</field>
        <field name="model">negative.inventory.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="picking_id"/>
                <field name="scrap_id"/>
                <field name="quant_id"/>
                <field name="requested_by"/>
                <filter name="to_approve" string="To Approve" domain="[('state', '=', 'to_approve')]"/>
                <filter name="mine" string="My Requests" domain="[('requested_by', '=', uid)]"/>
                <group>
                    <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="negative_inventory_request_action" model="ir.actions.act_window">
        <field name="name">Negative Stock Requests</field>
        <field name="res_model">negative.inventory.request</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_to_approve': 1}</field>
    </record>

    <!-- Core's own top-level menus sit at sequence 99 (Reporting) and 100
         (Configuration) - bump Configuration to 101 so ours can slot in at
         100, right after Reporting instead of at the very end. -->
    <record id="stock.menu_stock_config_settings" model="ir.ui.menu">
        <field name="sequence">101</field>
    </record>

    <menuitem id="menu_negative_inventory_root"
              name="Negative Stock Handling"
              parent="stock.menu_stock_root"
              sequence="100"/>
    <menuitem id="menu_negative_inventory_request"
              name="Approval Requests"
              parent="menu_negative_inventory_root"
              action="negative_inventory_request_action"
              sequence="10"/>
</odoo>
