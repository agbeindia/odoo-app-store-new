<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.rule" id="negative_inventory_request_company_rule">
        <field name="name">Negative Inventory Request multi-company</field>
        <field name="model_id" ref="model_negative_inventory_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record model="ir.rule" id="negative_inventory_log_company_rule">
        <field name="name">Negative Inventory Log multi-company</field>
        <field name="model_id" ref="model_negative_inventory_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
